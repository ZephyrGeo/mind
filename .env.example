# Local development only. Copy this file to .env.local if your process manager
# loads dotenv files, or export the values in your shell.
MIND_ENV=development
MIND_AUTH_PROVIDER=local
MIND_LOCAL_TOKEN=local-demo-token
MIND_FIREBASE_PROJECT_ID=
MIND_ALLOWED_USER_EMAILS=
MIND_REQUIRE_VERIFIED_EMAIL=0
MIND_FIREBASE_CHECK_REVOKED=1
MIND_ACCOUNT_DELETION_MAX_AUTH_AGE_SECONDS=600
MIND_PERSISTENCE_PROVIDER=json
MIND_FIRESTORE_DATABASE_ID=(default)
MIND_DATA_PATH=work/local-data/conversations.json
MIND_RESEARCH_DATA_PATH=work/local-data/research-jobs.json
MIND_API_HOST=127.0.0.1
MIND_API_PORT=8000
MIND_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MIND_MAX_REQUEST_BYTES=64000
MIND_MAX_CONTEXT_CHARACTERS=64000
MIND_MODEL_PROVIDER=fake
DEEPSEEK_API_KEY=
MIND_DEEPSEEK_BASE_URL=https://api.deepseek.com
MIND_DEEPSEEK_MODEL=deepseek-v4-flash
MIND_DEEPSEEK_TIMEOUT_SECONDS=120
MIND_DEEPSEEK_MAX_TOKENS=2048
MIND_RESEARCH_PROVIDER=openai
OPENAI_API_KEY=
MIND_OPENAI_BASE_URL=https://api.openai.com/v1
MIND_RESEARCH_MODEL=gpt-5.6-terra
MIND_RESEARCH_REASONING_EFFORT=high
MIND_RESEARCH_MAX_TOOL_CALLS=12
MIND_RESEARCH_MAX_SEARCH_ROUNDS=2
MIND_RESEARCH_MAX_SUBQUESTIONS=6
MIND_RESEARCH_MAX_TOTAL_TOOL_CALLS=24
MIND_RESEARCH_TOOL_CALL_OVERRUN_RATIO=0.15
MIND_RESEARCH_MAX_TOOL_CALL_OVERRUN=3
MIND_RESEARCH_MIN_CITATION_COVERAGE=0.8
MIND_RESEARCH_JOB_TIMEOUT_SECONDS=600
MIND_RESEARCH_POLL_INTERVAL_SECONDS=2
MIND_OPENAI_TIMEOUT_SECONDS=120
MIND_PUBLIC_API_BASE=http://127.0.0.1:8000
MIND_PUBLIC_AUTH_PROVIDER=local
MIND_PUBLIC_REQUIRE_VERIFIED_EMAIL=0
MIND_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
MIND_PUBLIC_FIREBASE_API_KEY=
MIND_PUBLIC_FIREBASE_AUTH_DOMAIN=
MIND_PUBLIC_FIREBASE_PROJECT_ID=
MIND_PUBLIC_FIREBASE_STORAGE_BUCKET=
MIND_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
MIND_PUBLIC_FIREBASE_APP_ID=
MIND_LOG_LEVEL=INFO
PORT=3000
